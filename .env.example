# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google sign-in needs no variables here. The client ID and secret live in the
# Supabase dashboard (Authentication > Providers > Google), and the redirect URL
# is built from the browser's own origin - so localhost, a Vercel preview and
# production all work, provided each origin is listed under
# Authentication > URL Configuration > Redirect URLs.

# PIN written by `npm run seed` into the unclaimed family. Real families choose
# their own PIN in the parent zone on first use.
SEED_PARENT_PIN=1234
